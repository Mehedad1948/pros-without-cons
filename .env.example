# Copy to .env and adjust. Never commit .env. All settings are optional.

# --- Storage -----------------------------------------------------------------
IGD_DATA_DIR=data
# IGD_DB_PATH=data/igdigest.db

# --- Collection provider ------------------------------------------------------
# fixture   : offline sample data (default; clearly labelled, never mixed into live checks)
# graph_api : official Instagram API with Facebook Login (Business Discovery; Business/Creator targets only)
# browser   : local Playwright connector using the session saved by `igdigest login`
# auto      : graph_api first, browser only for accounts the API cannot read
IGD_PROVIDER=fixture
IGD_FIXTURE_PATH=fixtures/sample_posts.json

IGD_INITIAL_IMPORT_LIMIT=5
IGD_MAX_POSTS_PER_CHECK=12
IGD_MAX_MEDIA_PER_POST=4
IGD_MAX_MEDIA_BYTES=50000000
IGD_RETRY_ATTEMPTS=3
IGD_RETRY_BASE_SECONDS=5

# --- Schedule -------------------------------------------------------------------
IGD_TIMEZONE=Asia/Tehran
IGD_CHECK_INTERVAL_HOURS=6
IGD_DIGEST_TIME=20:00
IGD_SCHEDULER_ENABLED=true
IGD_COLLECT_BEFORE_DIGEST=true

# --- Official API (graph_api / auto) -----------------------------------------------
# Facebook User access token with instagram_basic, instagram_manage_insights, pages_read_engagement,
# and the IG user ID of YOUR Instagram professional account (the one making the query).
IGD_GRAPH_ACCESS_TOKEN=
IGD_GRAPH_IG_USER_ID=
IGD_GRAPH_API_VERSION=v25.0

# --- Local browser connector (browser / auto) ------------------------------------------
# IGD_SESSION_PATH=data/session/instagram_state.json
IGD_BROWSER_HEADLESS=true
IGD_BROWSER_DELAY_SECONDS=8
IGD_BROWSER_TIMEOUT_SECONDS=45
# Optional single fixed proxy for Chromium if your network needs one (no rotation), e.g.:
# IGD_BROWSER_PROXY=socks5://127.0.0.1:10808

# --- Media extraction -------------------------------------------------------------------
# OCR: pip install -e .[ocr] and install the Tesseract binary (add "fas" traineddata for Persian).
IGD_OCR_ENABLED=false
IGD_OCR_LANGUAGES=eng
# IGD_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Transcription: none | openai (pip install -e .[openai]) | faster_whisper (pip install -e .[transcribe-local])
IGD_TRANSCRIBE_PROVIDER=none
# IGD_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe   # or a faster-whisper size such as "small"
# IGD_TRANSCRIBE_API_KEY=
# IGD_TRANSCRIBE_BASE_URL=

# --- Feature 1: updates (new posts with links, NO LLM needed) ------------------------------
IGD_UPDATES_ENABLED=true
# Write an updates report after each scheduled check when there are new posts or failed checks.
IGD_UPDATES_AFTER_CHECK=true
IGD_UPDATES_MAX_ITEMS=100

# --- Feature 2: digest (LLM recap, optional) ---------------------------------------------------
# The digest only runs when IGD_DIGEST_ENABLED=true AND an LLM provider is set below.
IGD_DIGEST_ENABLED=true
# none      : no LLM; the digest is off (updates still work)
# anthropic : pip install -e .[anthropic]; default model claude-opus-5-5
# openai    : pip install -e .[openai]; any OpenAI-compatible endpoint (set IGD_LLM_BASE_URL if not OpenAI)
IGD_LLM_PROVIDER=none
# IGD_LLM_MODEL=claude-opus-5-5
# IGD_LLM_API_KEY=
# IGD_LLM_BASE_URL=
IGD_LLM_MAX_TOKENS=8000
# IGD_LLM_EFFORT=medium
IGD_LLM_REFUSAL_FALLBACK=true
IGD_DIGEST_LANGUAGE=English
IGD_MAX_ITEMS_PER_DIGEST=60

# --- Web -------------------------------------------------------------------------------------
IGD_WEB_HOST=127.0.0.1
IGD_WEB_PORT=8000
